<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Portfolio of Md. Nazrul Islam - IT Support, Computer Operations, MIS and Data Management professional from Dhaka, Bangladesh." />
    <meta name="theme-color" content="#031624" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Md. Nazrul Islam - Portfolio" />
    <meta property="og:description" content="IT Support, Computer Operations, MIS and Data Management." />
    <title>@ViewData["Title"] - Md. Nazrul Islam</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700;800&family=Hind+Siliguri:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Md.Nazrul.Islam.Portfolio.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/hero.css" asp-append-version="true" />
    <link rel="icon" href="~/favicon.ico" sizes="48x48" />
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="~/apple-touch-icon.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="og:image" content="https://nazrul.com/og-image.png" />
</head>
<body>
    <a href="#main" class="skip-link">Skip to content</a>
    <div class="scroll-progress" aria-hidden="true"></div>

    <header>
        <nav class="navbar navbar-expand-lg navbar-dark site-navbar fixed-top">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="~/images/brand/logo-icon-animated.svg" alt="" width="34" height="34" />
                    <span class="brand-name" data-no-i18n>Md. Nazrul Islam</span>
                </a>

                <div class="nav-tools order-lg-last ms-auto ms-lg-3 me-2 me-lg-0">
                    <button type="button" class="nav-tool-btn theme-toggle" aria-label="Toggle theme / থিম পরিবর্তন">
                        <i class="bi bi-sun icon-sun" aria-hidden="true"></i>
                        <i class="bi bi-moon-stars icon-moon" aria-hidden="true"></i>
                    </button>
                    <button type="button" class="nav-tool-btn lang-toggle" aria-label="Change language / ভাষা পরিবর্তন">
                        <span class="lang-to-bn">বাংলা</span>
                        <span class="lang-to-en">EN</span>
                    </button>
                </div>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index" asp-fragment="home" data-section="home">Home</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index" asp-fragment="about" data-section="about">About</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index" asp-fragment="education" data-section="education">Education</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index" asp-fragment="skills" data-section="skills">Skills</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index" asp-fragment="experience" data-section="experience">Experience</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index" asp-fragment="projects" data-section="projects">Projects</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index" asp-fragment="tools" data-section="tools">Tools</a></li>
                        <li class="nav-item ms-lg-3"><a class="btn btn-sm btn-outline-info nav-cta" asp-controller="Home" asp-action="Index" asp-fragment="contact">Let's talk</a></li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main id="main" role="main">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container footer-inner">
            <span>&copy; @DateTime.Now.Year Md. Nazrul Islam</span>
            <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <button type="button" class="back-to-top" aria-label="Back to top">
        <i class="bi bi-arrow-up" aria-hidden="true"></i>
    </button>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        (function () {
            var r = document.documentElement, t = "dark", l = "en";
            try { t = localStorage.getItem("theme") || "dark"; l = localStorage.getItem("lang") || "en"; } catch (e) {}
            r.setAttribute("data-theme", t === "light" ? "light" : "dark");
            if (l === "bn") { r.lang = "bn"; r.classList.add("i18n-pending"); }
        })();
    </script>
    <script src="~/js/theme.js" asp-append-version="true"></script>
    <script src="~/js/i18n.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
