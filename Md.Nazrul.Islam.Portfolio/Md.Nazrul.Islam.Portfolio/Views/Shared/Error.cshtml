@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<section class="error-section">
    <div class="container text-center">
        <p class="section-label">// Error</p>
        <h1 class="section-title">Someting went wrong</h1>
        <p>Sorry, the page you requested could not be shown. Please try agein later</p>

        @if(Model.ShowRequestId)
        {
            <p class="small">Request ID: <code>@Model.RequestId</code></p>
        }

        <a asp-controller="Home" asp-action="Index" class="btn btn-primary hero-btn mt-3">Back to home</a>
    </div>
</section>