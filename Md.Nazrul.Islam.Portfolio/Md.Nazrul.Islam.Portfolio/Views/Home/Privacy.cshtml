@{
    ViewData["Title"] = "Privacy Policy";
}

<section class="legal-section">
    <div class="container">
        <p class="section-label">// Privacy</p>
        <h1 class="section-title">@ViewData["Title"]</h1>

        <p>
            This website does not use advertising trackers. The only personal information
            collected is what you type into the contact form: your name, email address,
            subject and message.
        </p>
        <p>
            This information is stored in the website database and is used only to read
            and reply to your message. It is not sold or shared with anyone else.
        </p>
        <p>
            To ask for your message to be deleted, send an email using the address
            shown in the Contact section.
        </p>
    </div>
</section>
