@model HomeViewModel
@{
    ViewData["Title"] = "Home";
    var profile = Model.profile;
    var email = profile?.Email;
    var phone = profile?.Phone;

    // Only the two professional profiles go in the hero
    var heroSocials = Model.SocialLinks
        .Where(s => s.Platform.Equals("GitHub", StringComparison.OrdinalIgnoreCase)
                 || s.Platform.Equals("LinkedIn", StringComparison.OrdinalIgnoreCase))
        .ToList();
}

<!-- Hero -->
<section id="home" class="hero-section">
    <div class="container">
        <div class="row align-items-center gy-5">

            <div class="col-lg-7 hero-content">
                <p class="hero-greeting">HELLO, I'M</p>

                <h1 class="hero-name">@(profile?.FullName ?? "Md. Nazrul Islam")</h1>
                <h2 class="hero-title">IT Support &amp; Data Operations Professional</h2>

                <p class="hero-learning">
                    <span class="hero-learning-label">Currently learning</span>
                    <span class="hero-learning-words"><span id="typed-text" data-words="C#|ASP.NET Core|SQL Server">C#</span><span class="typed-cursor" aria-hidden="true">|</span></span>
                </p>

                <p class="hero-description">
                    IT support, MIS reporting and data management for FMCG distributors,
                    with a developer's mindset.
                </p>
                <div class="hero-buttons">
                    <a href="@(profile?.CVUrl ?? "/files/Md_Nazrul_Islam_CV.pdf")" class="btn btn-primary hero-btn" download>
                        Download CV
                        <span aria-hidden="true">&darr;</span>
                    </a>
                    <a href="/#projects" class="btn btn-outline-light hero-btn">
                        View My Projects
                        <span aria-hidden="true">&rarr;</span>
                    </a>
                </div>

                @if (heroSocials.Count > 0)
                {
                    <ul class="hero-social" aria-label="Social profiles">
                        @foreach (var link in heroSocials)
                        {
                            <li>
                                <a href="@link.Url" target="_blank" rel="noopener noreferrer"
                                   aria-label="@link.Platform" title="@link.Platform">
                                    <i class="@link.IconClass" aria-hidden="true"></i>
                                </a>
                            </li>
                        }
                    </ul>
                }

                <ul class="hero-proof">
                    <li><strong>3+ years</strong><span>distributor operations</span></li>
                    <li><strong>Excel &amp; MIS</strong><span>daily sales reporting</span></li>
                    <li><strong>Marico &amp; Godrej</strong><span>FMCG distributors</span></li>
                </ul>

                <div class="hero-availability">
                    <span class="availability-dot" aria-hidden="true"></span>
                    <span><strong>Open to work</strong> IT Support, MIS &amp; Data roles in Dhaka</span>
                </div>
            </div>

            <div class="col-lg-5 hero-image-column">
                <div class="hero-photo">
                    <div class="hero-photo-clip">
                        <img src="~/images/nazrul-cutout.webp"
                             asp-append-version="true"
                             alt="Portrait of Md. Nazrul Islam"
                             class="hero-photo-img"
                             fetchpriority="high"
                             decoding="async" />
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>

<!-- About -->
<section id="about" class="about-section">
    <div class="container">
        <p class="section-label">// About Me</p>
        <h2 class="section-title">Professional Profile</h2>

        <div class="about-card" data-reveal>
            <p>
                Hello! I'm <strong>MD. NAZRUL ISLAM</strong>, an IT support
                and computer operations professional with experience in
                distributor operations, data management, sales reporting,
                and office automation.
            </p>

            <p>
                I am also developing my programming skills in C#,
                ASP.NET Core, and Microsoft SQL Server as I continue to grow
                toward a more technology-focused career.
            </p>

            <div class="about-highlights">
                <div class="about-highlight"><span class="highlight-symbol">&gt;_</span><span>IT Support</span></div>
                <div class="about-highlight"><span class="highlight-symbol">&gt;_</span><span>Data Management</span></div>
                <div class="about-highlight"><span class="highlight-symbol">&gt;_</span><span>Programming Learner</span></div>
            </div>
        </div>
        <div class="stats-row">
            <div class="stat" data-reveal>
                <span class="stat-number" data-count="3">3</span><span class="stat-number">+</span>
                <p>Years of Experience</p>
            </div>
            <div class="stat" data-reveal>
                <span class="stat-number" data-count="2">2</span>
                <p>Roles Held</p>
            </div>
            <div class="stat" data-reveal>
                <span class="stat-number" data-count="2">2</span>
                <p>FMCG Brands Supported</p>
            </div>
        </div>
    </div>
</section>

<!-- Education (from database) -->
<section id="education" class="education-section">
    <div class="container">
        <p class="section-label">// Education</p>
        <h2 class="section-title">Academic Background</h2>

        <p class="education-intro">
            My academic journey has helped me build a foundation
            in computer science, technology and general education.
        </p>

        <div class="education-timeline">
            @foreach (var edu in Model.Educations)
            {
                <article class="education-card" data-reveal>
                    <div class="education-card-header">
                        <span class="education-marker">&gt;_</span>
                        <span class="education-period">@edu.StartYear &ndash; @(edu.EndYear?.ToString() ?? "Present")</span>
                    </div>

                    <h3>@edu.Degree</h3>
                    <p class="education-institution">@edu.Institution</p>

                    @if (!string.IsNullOrWhiteSpace(edu.Result))
                    {
                        <div class="education-result">
                            <span>Result</span>
                            <strong>@edu.Result</strong>
                        </div>
                    }
                </article>
            }
        </div>
    </div>
</section>

<!-- Skills (from database) -->
<section id="skills" class="skills-section">
    <div class="container">
        <p class="section-label">// Skills</p>
        <h2 class="section-title">Technical &amp; Professional Skills</h2>

        @foreach (var category in Model.SkillCategories)
        {
            <div class="skill-category">
                <h3><span class="skill-prompt">&gt;_</span> @category.Name</h3>

                <div class="skill-grid">
                    @foreach (var skill in category.Skills)
                    {
                        <article class="skill-card" data-reveal>
                            <h4>@skill.Name</h4>
                            <p>@skill.Description</p>
                        </article>
                    }
                </div>
            </div>
        }
    </div>
</section>

<!-- Experience (from database) -->
<section id="experience" class="experience-section">
    <div class="container">
        <p class="section-label">// Experience</p>
        <h2 class="section-title">Professional Experience</h2>

        <div class="timeline">
            @foreach (var job in Model.Experiences)
            {
                <article class="timeline-item" data-reveal>
                    <span class="timeline-dot" aria-hidden="true"></span>
                    <div class="timeline-card">
                        <div class="timeline-head">
                            <h3>@job.JobTitle</h3>
                            <span class="education-period">
                                @job.StartDate.ToString("MMM yyyy") &ndash;
                                @(job.IsCurrent || job.EndDate == null ? "Present" : job.EndDate.Value.ToString("MMM yyyy"))
                            </span>
                        </div>

                        <p class="timeline-company">
                            @job.Company
                            @if (!string.IsNullOrWhiteSpace(job.Location))
                            {
                                <span class="timeline-location">&middot; @job.Location</span>
                            }
                        </p>

                        @if (!string.IsNullOrWhiteSpace(job.Description))
                        {
                            <p class="timeline-desc">@job.Description</p>
                        }
                    </div>
                </article>
            }
        </div>
    </div>
</section>

<!-- Projects (from database) -->
<section id="projects" class="projects-section">
    <div class="container">
        <p class="section-label">// Projects</p>
        <h2 class="section-title">Featured Projects</h2>

        @if (Model.Projects.Count == 0)
        {
            <p class="empty-note">Projects will be added soon.</p>
        }
        else
        {
            <div class="project-grid">
                @foreach (var project in Model.Projects)
                {
                    <article class="project-card" data-reveal>
                        <h3>@project.Title</h3>
                        <p>@project.ShortDescription</p>

                        @if (!string.IsNullOrWhiteSpace(project.Technologies))
                        {
                            <ul class="tech-tags">
                                @foreach (var tech in project.Technologies.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                                {
                                    <li>@tech</li>
                                }
                            </ul>
                        }

                        <div class="project-links">
                            @if (!string.IsNullOrWhiteSpace(project.GithubUrl))
                            {
                                <a href="@project.GithubUrl" target="_blank" rel="noopener noreferrer">
                                    <i class="bi bi-github" aria-hidden="true"></i> Code
                                </a>
                            }
                            @if (!string.IsNullOrWhiteSpace(project.LiveDemoUrl))
                            {
                                <a href="@project.LiveDemoUrl" target="_blank" rel="noopener noreferrer">
                                    <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i> Live Demo
                                </a>
                            }
                        </div>
                    </article>
                }
            </div>
        }
    </div>
</section>

<!-- Tools (from database) -->
<section id="tools" class="tools-section">
    <div class="container">
        <p class="section-label">// Tools</p>
        <h2 class="section-title">Tools &amp; Technologies</h2>

        <div class="tools-grid">
            @foreach (var tool in Model.Tools)
            {
                <article class="tool-card" data-reveal>
                    <div class="tool-icon"><i class="@tool.IconClass" aria-hidden="true"></i></div>
                    <h3>@tool.Name</h3>
                    <p class="tool-category">@tool.Category</p>
                    <p class="tool-description">@tool.Description</p>
                </article>
            }
        </div>
    </div>
</section>

<!-- Contact -->
<section id="contact" class="contact-section">
    <div class="container">
        <p class="section-label">// Contact</p>
        <h2 class="section-title">Get In Touch</h2>

        @if (TempData["ContactSuccess"] is string okMessage)
        {
            <div class="alert alert-success" role="status">@okMessage</div>
        }
        @if (TempData["ContactError"] is string errorMessage)
        {
            <div class="alert alert-danger" role="alert">@errorMessage</div>
        }

        <div class="contact-grid">
            <div class="contact-info">
                <p>
                    I'm open to IT support, MIS, data management and sales operations
                    roles. Send me a message and I will reply as soon as possible.
                </p>

                <ul class="contact-list">
                    @if (!string.IsNullOrWhiteSpace(email))
                    {
                        <li><i class="bi bi-envelope" aria-hidden="true"></i><a href="mailto:@email">@email</a></li>
                    }
                    @if (!string.IsNullOrWhiteSpace(phone))
                    {
                        <li>
                            <i class="bi bi-whatsapp" aria-hidden="true"></i>
                            <a href="https://wa.me/@(phone.Replace("+", "").Replace(" ", ""))" target="_blank" rel="noopener noreferrer">WhatsApp</a>
                        </li>
                    }
                    @if (!string.IsNullOrWhiteSpace(profile?.Location))
                    {
                        <li><i class="bi bi-geo-alt" aria-hidden="true"></i>@profile.Location</li>
                    }
                </ul>

                <div class="social-links">
                    @foreach (var link in Model.SocialLinks)
                    {
                        <a href="@link.Url" target="_blank" rel="noopener noreferrer">
                            <i class="@link.IconClass" aria-hidden="true"></i> @link.Platform
                        </a>
                    }
                </div>
            </div>

            <form asp-controller="Home" asp-action="Contact" method="post" class="contact-form">
                <div class="visually-hidden" aria-hidden="true">
                    <label for="Website">Leave this field empty</label>
                    <input type="text" id="Website" name="Website" tabindex="-1" autocomplete="off" />
                </div>

                <div class="mb-3">
                    <label for="Name" class="form-label">Name</label>
                    <input type="text" id="Name" name="Name" class="form-control" maxlength="150" required />
                </div>
                <div class="mb-3">
                    <label for="Email" class="form-label">Email</label>
                    <input type="email" id="Email" name="Email" class="form-control" maxlength="255" required />
                </div>
                <div class="mb-3">
                    <label for="Subject" class="form-label">Subject</label>
                    <input type="text" id="Subject" name="Subject" class="form-control" maxlength="250" required />
                </div>
                <div class="mb-3">
                    <label for="Message" class="form-label">Message</label>
                    <textarea id="Message" name="Message" class="form-control" rows="5" minlength="10" maxlength="2000" required></textarea>
                </div>

                <button type="submit" class="btn btn-primary hero-btn">
                    Send Message <i class="bi bi-send" aria-hidden="true"></i>
                </button>
            </form>
        </div>
    </div>
</section>
