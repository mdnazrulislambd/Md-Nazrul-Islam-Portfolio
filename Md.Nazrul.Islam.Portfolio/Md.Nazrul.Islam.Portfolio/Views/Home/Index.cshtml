@{
    ViewData["Title"] = "Home";
}

<section id="home" class="hero-section">
    <div class="container">
        <div class="row align-items-center gy-5">

            <!-- Left: Introduction -->
            <div class="col-lg-7 hero-content">

                <p class="hero-greeting">
                    HELLO, I'M
                </p>

                <h1 class="hero-name">
                    Md. Nazrul Islam
                </h1>

                <h2 class="hero-title">
                    IT Support &amp; Computer Operations
                </h2>

                <p class="hero-specialties">
                    MIS &amp; Data Management
                    <span>|</span>
                    Sales Operations
                </p>

                <p class="hero-description">
                    I bring together technology, data management, and
                    operational experience to support reliable digital 
                    workflows and efficient business operations.
                </p>

                <div class="hero-buttons">
                    <a href="/#projects" class="btn btn-primary hero-btn">
                    View My Projects
                    <span aria-hidden="true">&rarr;</span>
                    </a>

                    <a href="/#contact" class="btn btn-outline-light hero-btn">
                    Contact Me    
                    </a>

                    <a href="~/files/Md_Nazrul_Islam_CV.pdf" class="btn btn-outline-info hero-btn" download>
                        Download CV
                        <span aria-hidden="true">&darr;</span>
                    </a>
                </div>

                <div class="hero-availability">
                    <span class="availability-dot"></span>
                    Open to professional opportunities
                </div>

            </div>

            <!-- Right: Profile Image -->
            <div class="col-lg-5 hero-image-column">
                <div class="hero-image-frame">
                    <img src="~/images/nazrul-profile.jpg"
                    asp-append-version="true"
                    alt="Portrait of Md. Nazrul Islam"
                    class="hero-profile-image" />
                </div>
            </div>

        </div>
    </div>
</section>

                    <!-- About Section -->
<section id="about" class="about-section">
    <div class="container">

        <p class="section-label">// About Me</p>

        <h2 class="section-title">
            Professional Profile
        </h2>

        <div class="about-card">
            <p>
                Hello! I'm <strong>MD. NAZRUL ISLAM</strong>, an IT support
                and computer operations professional with experience in
                distributor operations, date management, sales reporting,
                and office automation.
            </p>

            <p>
                I am also developing my programing skills in C#, .NET
                Framework, and Microsoft SQL Server as I continue to grow
                toward a more technology-focused career.
            </p>

            <div class="about-highlights">
                <div class="about-highlight">
                    <span class="highlight-symbol">&gt;_</span>
                    <span>IT Support</span>
                </div>

                <div class="about-highlight">
                    <span class="highlight-symbol">&gt;_</span>
                    <span>Data Management</span>
                </div>

                <div class="about-highlight">
                    <span class="highlight-symbol">&gt;_</span>
                    <span>Programming Learner</span>
                </div>
            </div>
        </div>

    </div>
</section>

                    <!-- Education Section -->


<section id="education" class="education-section">
    <div class="container">

        <p class="section-label">// Education</p>

        <h2 class="section-title">
            Academic Background
        </h2>

        <p class="education-intro">
            My academic journey has helped me build a foundation 
            in computer science, technology and general education.
        </p>

        <div class="education-timeline">

            <!-- Diploma -->
            <article class="education-card">
                <div class="education-card-header">
                    <span class="education-marker">&gt;_</span>
                    <span class="education-period">2024 - 2025</span>
                </div>

                <h3>Diploma in Computer Science and Application</h3>

                <p class="education-institution">
                    Bangladesh Open University
                </p>

                <div class="education-result">
                    <span>CGPA</span>
                    <strong>2.84 / 4.00</strong>
                </div>
            </article>

            <!-- HSC -->
            <article class="education-card">
                <div class="education-card-header">
                    <span class="education-marker">&gt;_</span>
                    <span class="education-period">2018 - 2020</span>
                </div>

                <h3>Higher Secondary Cerificate (HSC)</h3>

                <p class="education-institution">
                    Jafarganj Mir Abdul Gafur College
                </p>

                <div class="education-result">
                    <span>GPA</span>
                    <strong>3.42 / 5.00</strong>
                </div>
            </article>

            <!-- SSC -->
            <article class="education-card">
                <div class="education-card-header">
                    <span class="education-marker">&gt;_</span>
                    <span class="education-period">2016 - 2018</span>
                </div>

                <h3>Secondary School Certificate (SSC)</h3>

                <p class="education-institution">
                    Debidwar Govt. Reaz Uddin Pilot Model High School
                </p>

                <div class="education-result">
                    <span>GPA</span>
                    <strong>3.00 / 5.00</strong>
                </div>
            </article>

        </div>
    </div>
</section>