@{
    ViewData["Title"] = "Home";
}

<section id="home" class="hero-section">
    <div class="container">
        <div class="row align-items-center gy-5">

            <!-- Lest: Introduction -->
            <div class="col-lg-7 hero-content">

                <p class="hreo-greeting">
                    HELLO, I'M
                </p>

                <h1 class="hero-name">
                    Md. Nazrul Islam
                </h1>

                <h2 class="hero-title">
                    IT Support &amp; Computer Operations
                </h2>

                <p class="hero-specialtes">
                    MIS &amp; Data Management
                    <span>|</span>
                    Sales Operations
                </p>

                <p class="hero-description">
                    I bring together technology, date management, and
                    operational experience to support reliable digital 
                    workflows and efficient business operations.
                </p>

                <div class="hero-buttons">
                    <a href="/#projects" class="btn btn-primary hero-btn">
                    View My Projects
                    <span aria-hidden="true">&rarr;</span>
                    </a>

                    <a href="/#contact" class="btn btn-outline-light hero-btn">
                    Contact Me    
                    </a>

                    <a href="~/files/Md_Nazrul_Islam_CV.pdf" class="btn btn-outline-info hero-btn" download>
                        Download CV
                        <span aria-hidden="true">&darr;</span>
                    </a>
                </div>

                <div class="hero-availability">
                    <span class="availability-dot"></span>
                    Open to professional opportunities
                </div>

            </div>

            <!-- Right: Profile Image -->
            <div class="col-lg-5 hero-image-column">
                <div class="hero-image-frame">
                    <img src="~/images/nazrul-profile.jpg"
                    asp-append-version="true"
                    alt="Portrait of Md. Nazrul Islam"
                    class="hero-profile-image" />
                </div>
            </div>

        </div>
    </div>
</section>